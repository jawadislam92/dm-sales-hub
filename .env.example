# Copy to .env and fill in. Nothing secret is committed.

# --- server ---
HOST=0.0.0.0
PORT=8080

# Data source the dashboards read from:
#   snapshot = read the sheet snapshot file at DATA_DIR (zero setup, local/demo)
#   pg       = read the database (run the backfill first)
DATA_BACKEND=pg
PGDATA_DIR=./.pgdata
# Only used when DATA_BACKEND=snapshot (path to site_data.json + dash.json):
DATA_DIR=./data

# --- login (email allow-list, magic link) ---
# AUTH_ENABLED=1 turns on login. Leave unset/0 for an open local review.
AUTH_ENABLED=1
# Comma-separated admin emails seeded on boot:
ALLOWLIST_BOOTSTRAP=you@dailymentor.co
# REQUIRED in prod — long random string; signs sessions + magic links:
SESSION_SECRET=change-me-to-a-long-random-string
# SMTP connection URL to email magic links in prod (e.g. smtps://user:pass@host:465).
# If unset, links are written to the server log (dev only).
SMTP_URL=

# --- webhook inbox (/ingest, Phase 2) ---
# Static secret each Zapier POST must send as the X-Webhook-Secret header:
WEBHOOK_SHARED_SECRET=change-me-too
